# ==============================================================================
# AuraLuxe Hospitality & Resorts - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' for local development or paste these values into
# your Vercel Project Settings -> Environment Variables for production.
# ==============================================================================

# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AuraLuxe Hospitality & Resorts"
# For local dev: http://localhost:3000
# For production (Vercel): https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_BASE_URL="/api/v1"

# 2. SUPABASE DIRECT POSTGRESQL CONNECTION (For DB Migrations & Direct Queries)
# ------------------------------------------------------------------------------
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres"

# 3. SUPABASE REST API & ACCESS KEYS
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your_project_ref.supabase.co"
SUPABASE_URL="https://your_project_ref.supabase.co"

# Supabase Public Anonymous Key (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# 4. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Razorpay API Key ID (e.g., rzp_test_... or rzp_live_...)
RAZORPAY_KEY="rzp_test_your_key_id"
NEXT_PUBLIC_RAZORPAY_KEY="rzp_test_your_key_id"

# Razorpay Secret Key (SERVER-SIDE ONLY for verifying webhook & order signatures)
RAZORPAY_SECRET="your_razorpay_secret_key"

# 5. JWT & SESSION ENCRYPTION SECRET
# ------------------------------------------------------------------------------
# Random 32+ character string for signing HttpOnly management and client tokens
JWT_SECRET="auraluxe-luxury-hotel-super-secret-key-32chars-minimum"

# 6. MANAGEMENT PORTAL DEFAULT ADMINISTRATIVE CREDENTIALS
# ------------------------------------------------------------------------------
# Hotel Partner default administrative password (for first-time hotel setup)
HOTEL_PASS="AuraHotel@2026"
DEFAULT_HOTEL_ADMIN_PASSWORD="AuraHotel@2026"

# Global Super Admin credentials (Hidden Master Portal: /management/admin/login)
SUPER_ADMIN_EMAIL="admin@auraluxe.com"
SUPER_ADMIN_PASSWORD="AuraMaster@2026"
